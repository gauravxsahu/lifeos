u0986\u09aa\u09a8\u09be\u09b0 LIFEOS \u09ad\u09af\u09bc\u09c7\u09b8 \u09b8\u0999\u09cd\u0997\u09c0\u0964 \u0986\u099c \u0986\u09aa\u09a8\u09be\u09b0 \u09b2\u0995\u09cd\u09b7\u09cd\u09af \u09aa\u09c2\u09b0\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b6\u09c1\u09ad\u0995\u09be\u09ae\u09a8\u09be!'},{code:'ta',label:'\u0ba4\u0bae\u0bbf\u0bb4\u0bcd (Tamil)',flag:'\ud83c\uddee\ud83c\uddf3',testPhrase:'\u0bb5\u0ba3\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0ba8\u0ba3\u0bcd\u0baa\u0bbe! \u0b87\u0ba4\u0bc1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd LIFEOS \u0b95\u0bc1\u0bb0\u0bb2\u0bcd \u0ba4\u0bc1\u0ba3\u0bc8. \u0b87\u0ba9\u0bcd\u0bb1\u0bc1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bc8 \u0b85\u0b9f\u0bc8\u0baf \u0bb5\u0bbe\u0bb4\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bb3\u0bcd!'},{code:'te',label:'\u0c24\u0c46\u0c32\u0c41\u0c17\u0c41 (Telugu)',flag:'\ud83c\uddee\ud83c\uddf3',testPhrase:'\u0c28\u0c2e\u0c38\u0c4d\u0c15\u0c3e\u0c30\u0c02 \u0c2e\u0c3f\u0c24\u0c4d\u0c30\u0c2e\u0c3e! \u0c07\u0c26\u0c3f \u0c2e\u0c40 LIFEOS \u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c38\u0c39\u0c3e\u0c2f\u0c15\u0c41\u0c21\u0c41. \u0c08\u0c30\u0c4b\u0c1c\u0c41 \u0c2e\u0c40 \u0c32\u0c15\u0c4d\u0c37\u0c4d\u0c2f\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c3e\u0c27\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f!'},{code:'gu',label:'\u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4\u0ac0 (Gujarati)',flag:'\ud83c\uddee\ud83c\uddf3',testPhrase:'\u0aa8\u0aae\u0ab8\u0acd\u0aa4\u0ac7 \u0aae\u0abf\u0aa4\u0acd\u0ab0! \u0a86 \u0aa4\u0aae\u0abe\u0ab0\u0acb LIFEOS \u0ab5\u0acb\u0a88\u0ab8 \u0ab8\u0abe\u0aa5\u0ac0 \u0a9b\u0ac7. \u0a86\u0a9c\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab2\u0a95\u0acd\u0ab7\u0acd\u0aaf\u0acb \u0aaa\u0ab0 \u0aa7\u0acd\u0aaf\u0abe\u0aa8 \u0a86\u0aaa\u0acb!'},{code:'pa',label:'\u0a2a\u0a70\u0a1c\u0a3e\u0a2c\u0a40 (Punjabi)',flag:'\ud83c\uddee\ud83c\uddf3',testPhrase:'\u0a38\u0a24\u0a3f \u0a38\u0a4d\u0a30\u0a40 \u0a05\u0a15\u0a3e\u0a32 \u0a26\u0a4b\u0a38\u0a24! \u0a07\u0a39 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a3e LIFEOS \u0a35\u0a4c\u0a07\u0a38 \u0a38\u0a3e\u0a25\u0a40 \u0a39\u0a48\u0964 \u0a05\u0a71\u0a1c \u0a06\u0a2a\u0a23\u0a47 \u0a1f\u0a40\u0a1a\u0a3f\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a2a\u0a42\u0a30\u0a3e \u0a15\u0a30\u0a4b!'}],c=[{id:'FRIENDLY_FRIEND',label:'\ud83e\udd17 Friendly Friend'},{id:'MOTIVATOR',label:'\ud83d\ude80 Motivator'},{id:'CALM_COMPANION',label:'\ud83e\uddd8 Calm Companion'},{id:'PROFESSIONAL_MENTOR',label:'\ud83d\udc54 Professional Mentor'}];_e.SettingsScreen=({onOpenDiagnostics:e,onOpenPermissions:t})=>{var f=(0,r.useState)('hi'),x=(0,l.default)(f,2),p=x[0],b=x[1],u=(0,r.useState)('FRIENDLY_FRIEND'),y=(0,l.default)(u,2),T=y[0],j=y[1],S=(0,r.useState)(!0),w=(0,l.default)(S,2),C=w[0],v=w[1],B=(0,r.useState)(!0),P=(0,l.default)(B,2),V=P[0],O=P[1],R=(0,r.useState)(1),W=(0,l.default)(R,2),k=W[0],I=W[1],z=(0,r.useState)(!1),A=(0,l.default)(z,2),F=A[0],D=A[1],E=s.find(e=>e.code===p)||s[0],_=(function(){var e=(0,o.default)(function*(){D(!0),yield _r(d[6]).TextToSpeechBridge.speak(E.testPhrase,E.code,k),setTimeout(()=>D(!1),3e3)});return function(){return e.apply(this,arguments)}})(),L=(function(){var e=(0,o.default)(function*(){yield _r(d[6]).TextToSpeechBridge.stop(),D(!1)});return function(){return e.apply(this,arguments)}})();return(0,a.jsxs)(n.ScrollView,{style:h.container,children:[(0,a.jsx)(n.Text,{style:h.title,children:"Voice & Preferences"}),(0,a.jsx)(n.Text,{style:h.subtitle,children:"Multi-language voice companion and gentle intervention settings."}),(0,a.jsxs)(n.View,{style:h.card,children:[(0,a.jsxs)(n.View,{style:h.cardHeader,children:[(0,a.jsx)(n.Text,{style:h.cardTitle,children:"\ud83d\udde3\ufe0f Voice Assistant Language"}),(0,a.jsxs)(n.Text,{style:h.activeBadge,children:[E.flag," ",E.label]})]}),(0,a.jsx)(n.Text,{style:h.helpText,children:"Select your preferred voice companion language:"}),(0,a.jsx)(n.View,{style:h.langGrid,children:s.map(e=>{var t=p===e.code;return(0,a.jsxs)(n.TouchableOpacity,{style:[h.langChip